  let full_url = (build-url $base ({qop: (encode-path-segment $qop), user: (encode-path-segment $user), passwd: (encode-path-segment $passwd), algorithm: (encode-path-segment $algorithm), stale_after: (encode-path-segment $stale_after)} | format pattern "/digest-auth/{qop}/{user}/{passwd}/{algorithm}/{stale_after}"))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" null {query: {}, body: null}
}

# Drips data over a duration after an optional initial delay.
#
# GET /drip
export def "drip get" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --duration: float # The amount of time (in seconds) over which to drip each byte (default: 2)
  --numbytes: int # The number of bytes to respond with (default: 10)
  --code: int # The response code that will be returned (default: 200)
  --delay: float # The amount of time (in seconds) to delay before responding (default: 2)
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "duration" $duration "scalar") (serialize-qp "numbytes" $numbytes "scalar") (serialize-qp "code" $code "scalar") (serialize-qp "delay" $delay "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/drip" $qp)
  let accept_val = "application/octet-stream"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" null {query: ({"duration": $duration, "numbytes": $numbytes, "code": $code, "delay": $delay} | compact), body: null}
}

